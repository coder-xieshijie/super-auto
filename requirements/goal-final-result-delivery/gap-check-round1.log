async function cmdPoll(positional, flags) {
  const [apiPath] = positional;
  const condition = parseCondition(flags.until);
  if (!apiPath || !condition) {
    fail(
      'usage: poll <path> --until <field>=<v1|v2> | <field>~<text> [--hold s] [--show a,b] [--interval s] [--timeout s] [--save name]',
    );
  }
  const { state } = resolveRun(flags, flags.on ?? 'runtime');
  const { field } = condition;
  const show = typeof flags.show === 'string' ? flags.show.split(',') : [field];
  const interval = Number(flags.interval ?? (flags.hold ? 2 : 5)) * 1000;
  const holdMs = Number(flags.hold ?? 0) * 1000;
  const deadline = Date.now() + Number(flags.timeout ?? 600) * 1000;
  const trajectory = [];
  let last;
  let final;
  let heldSince;
  const finish = (ok, reason) => {
    const suffix = ok ? '' : `-${reason}`;
    const saved =
      typeof flags.save === 'string'
        ? writeEvidence(state, `${flags.save}${suffix}`, {
            poll: { path: apiPath, until: flags.until, holdSeconds: holdMs / 1000 },
            trajectory,
            final,
          })
        : undefined;
    const result = {
      ok,
      matched: pick(final, field),
      ...(saved ? { saved } : {}),
      trajectory,
      final,
    };
    if (ok) out(result);
    else fail(`poll ${reason}`, result);
  };
  while (Date.now() < deadline || heldSince !== undefined) {
    const result = await request(state, 'GET', apiPath, undefined, 30_000);
    final = result.body;
    const view = Object.fromEntries(show.map((key) => [key, pick(final, key)]));
    const signature = JSON.stringify(view);
    if (signature !== last) {
      last = signature;
      trajectory.push({ at: Date.now(), ...view });
      process.stderr.write(`${new Date().toISOString()} ${signature}\n`);
    }
    const matches = condition.test(pick(final, field));
    // With --hold, the condition must stay true for the whole window after it first matches.
    if (heldSince !== undefined && !matches) return finish(false, 'hold-broken');
    if (matches) {
      heldSince ??= Date.now();
      if (Date.now() - heldSince >= holdMs) return finish(true);
    }
    await new Promise((resolve) => setTimeout(resolve, interval));
  }
  finish(false, 'timeout');
}

