import type { MessagePart } from '@/store/message.js';

export type AssistantSegmentContentPart = Extract<MessagePart, { type: 'text' }>;

export interface AssistantSegment {
  id: string;
  contentPart: AssistantSegmentContentPart;
  eventParts: MessagePart[];
}

export interface AssistantSegmentResult {
  leadingParts: MessagePart[];
  archivedParts: MessagePart[];
  timelineSegments: AssistantSegment[];
  activeSegment: AssistantSegment | null;
}

export interface BuildAssistantSegmentsOptions {
  preferGoalCompletionResult?: boolean;
  /** Keep the first pre-steer body stable while the Turn runs or waits for input. */
  preservePreSteerBody?: boolean;
}

function isSegmentContentPart(part: MessagePart): part is AssistantSegmentContentPart {
  return part.type === 'text';
}

function parseToolInput(input: unknown): unknown {
  if (typeof input !== 'string') return input;
  try {
    return JSON.parse(input) as unknown;
  } catch {
    return input;
  }
}

function isCompletedGoalUpdate(part: MessagePart): boolean {
  if (part.type !== 'tool_call') return false;
  if (part.tool_call.status !== 'done' || part.tool_call.name.toLowerCase() !== 'update_goal') {
    return false;
  }
  const input = parseToolInput(part.tool_call.input);
  if (!input || typeof input !== 'object' || Array.isArray(input)) return false;
  return (input as { status?: unknown }).status === 'complete';
}

function findPreviousContentIndex(parts: MessagePart[], fromIndex: number): number {
  for (let index = fromIndex; index >= 0; index -= 1) {
    const part = parts[index];
    if (part && isSegmentContentPart(part)) return index;
  }
  return -1;
}

function findFirstPreSteerContentIndex(parts: MessagePart[]): number {
  for (let index = 0; index < parts.length; index += 1) {
    if (parts[index]?.type !== 'steered_user') continue;
    const contentIndex = findPreviousContentIndex(parts, index - 1);
    if (contentIndex >= 0) return contentIndex;
  }
  return -1;
}

interface ActiveContentSelection {
  index: number;
  archiveNonActiveParts: boolean;
}

function resolveActiveContent(
  parts: MessagePart[],
  lastContentIndex: number,
  options: BuildAssistantSegmentsOptions,
): ActiveContentSelection {
  if (options.preservePreSteerBody) {
    const preSteerContentIndex = findFirstPreSteerContentIndex(parts);
    if (preSteerContentIndex >= 0) {
      return { index: preSteerContentIndex, archiveNonActiveParts: false };
    }
  }

  if (!options.preferGoalCompletionResult) {
    return { index: lastContentIndex, archiveNonActiveParts: false };
  }

  for (let index = parts.length - 1; index >= 0; index -= 1) {
    const part = parts[index];
    if (!part || !isCompletedGoalUpdate(part)) continue;

    const precedingContentIndex = findPreviousContentIndex(parts, index - 1);
    if (precedingContentIndex < 0 || precedingContentIndex === lastContentIndex) {
      return { index: lastContentIndex, archiveNonActiveParts: false };
    }

    const precedingContent = parts[precedingContentIndex] as AssistantSegmentContentPart;
    const latestContent = parts[lastContentIndex] as AssistantSegmentContentPart;
    return precedingContent.content.trim().length > latestContent.content.trim().length
      ? { index: precedingContentIndex, archiveNonActiveParts: true }
      : { index: lastContentIndex, archiveNonActiveParts: false };
  }

  return { index: lastContentIndex, archiveNonActiveParts: false };
}

export function buildAssistantSegments(
  parts: MessagePart[],
  options: BuildAssistantSegmentsOptions = {},
): AssistantSegmentResult {
  const firstContentIndex = parts.findIndex(isSegmentContentPart);
  const lastContentIndex = (() => {
    for (let index = parts.length - 1; index >= 0; index -= 1) {
      const part = parts[index];
      if (part && isSegmentContentPart(part)) return index;
    }
    return -1;
  })();

  if (lastContentIndex < 0) {
    return {
      leadingParts: parts,
      archivedParts: parts,
      timelineSegments: [],
      activeSegment: null,
    };
  }

  const leadingParts = firstContentIndex > 0 ? parts.slice(0, firstContentIndex) : [];
  const activeContent = resolveActiveContent(parts, lastContentIndex, options);
  const activeContentIndex = activeContent.index;
  const archivedParts = activeContent.archiveNonActiveParts
    ? parts.filter((_, index) => index !== activeContentIndex)
    : parts.slice(0, activeContentIndex);
  const timelineSegments = buildTimelineSegments(archivedParts);
  const eventParts = activeContent.archiveNonActiveParts ? [] : parts.slice(activeContentIndex + 1);
  const activeContentPart = parts[activeContentIndex] as AssistantSegmentContentPart;

  return {
    leadingParts,
    archivedParts,
    timelineSegments,
    activeSegment: {
      id: `segment-${activeContentPart.id}`,
      contentPart: activeContentPart,
      eventParts,
    },
  };
}

function buildTimelineSegments(parts: MessagePart[]): AssistantSegment[] {
  const timelineSegments: AssistantSegment[] = [];
  let currentSegment: AssistantSegment | null = null;

  for (const part of parts) {
    if (isSegmentContentPart(part)) {
      if (currentSegment) {
        timelineSegments.push(currentSegment);
      }
      currentSegment = {
        id: `segment-${part.id}`,
        contentPart: part,
        eventParts: [],
      };
      continue;
    }

    if (currentSegment) {
      currentSegment.eventParts.push(part);
    }
  }

  if (currentSegment) {
    timelineSegments.push(currentSegment);
  }

  return timelineSegments;
}

