diff --git a/packages/ui/src/components/message/resultDeliveryCards.ts b/packages/ui/src/components/message/resultDeliveryCards.ts
new file mode 100644
index 0000000000..8b98f3d2ea
--- /dev/null
+++ b/packages/ui/src/components/message/resultDeliveryCards.ts
@@ -0,0 +1,21 @@
+import { createContext, useContext } from 'react';
+
+/**
+ * Delivery cards of a completed Goal message, where one file gets one card.
+ * Card renderers inside that message skip a path whose key is already shown
+ * elsewhere in the result, and keep only the first card per key they render.
+ */
+export interface ResultDeliveryCards {
+  /** Dedupe key of a delivered path in this message (normalized path). */
+  keyOf(path: string): string;
+  /** Keys already shown in another part of the result area. */
+  readonly shownElsewhere: ReadonlySet<string>;
+}
+
+const ResultDeliveryCardsContext = createContext<ResultDeliveryCards | null>(null);
+
+export const ResultDeliveryCardsProvider = ResultDeliveryCardsContext.Provider;
+
+export function useResultDeliveryCards(): ResultDeliveryCards | null {
+  return useContext(ResultDeliveryCardsContext);
+}
