+
+const SESSION = 'sess_goal_final_reply';
+const OBJECTIVE = 'Create hello.html whose main heading reads Hello Goal.';
+
+type ScriptedResponse =
+  | { readonly type: 'text'; readonly text: string }
+  | { readonly type: 'empty' }
+  | {
+      readonly type: 'tool';
+      readonly name: string;
+      readonly arguments: Record<string, unknown>;
+      readonly before?: () => Promise<void> | void;
+    }
+  | {
+      /** Several tool calls in one assistant message (one batch). */
+      readonly type: 'tools';
+      readonly calls: readonly { readonly name: string; readonly arguments: Record<string, unknown> }[];
+    }
+  | { readonly type: 'error'; readonly message: string }
+  | { readonly type: 'abort'; readonly before?: () => Promise<void> | void };
+
+interface TurnRun {
+  readonly status: 'completed' | 'aborted' | 'failed' | 'unknown';
+  /** Assistant/tool messages committed to history, in order. */
+  readonly history: AgentMessage[];
+  /** Provider requests made after the accepted completion result. */
+  readonly requestsAfterCompletion: number;
+  /** Provider contexts, one per request. */
+  readonly contexts: AgentMessage[][];
+  readonly finalAssistantText: string;
+}
