+    maxTokens: 8_192,
+  };
+}
+
+function eventStream(
+  events: AssistantMessageEvent[],
+  final: AssistantMessage,
+): AssistantMessageEventStream {
+  return {
+    [Symbol.asyncIterator]() {
+      let index = 0;
+      return {
+        async next() {
+          return index < events.length
+            ? { value: events[index++]!, done: false }
