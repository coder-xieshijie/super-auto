+        text('a', deliver('C:\\Work Dir\\out\\report.pdf')),
+        text('b', deliver('c:/work dir/out/report.pdf', 'C:\\Work Dir\\out\\data file.csv')),
+      ],
+      bodyContent: deliver('C:/Work Dir/out/data file.csv'),
+      workspaceDir: 'C:\\Work Dir',
+    });
+
+    expect(lifted?.deliverItems.map((item) => item.path)).toEqual([
+      'C:\\Work Dir\\out\\report.pdf',
+    ]);
+    expect(lifted?.resultPathKeys.has(deliveryPathKey('out\\data file.csv', 'C:\\Work Dir'))).toBe(
+      true,
+    );
+  });
+});
