+    expect(deliveryPathKey('hello.html', 'C:\\Users\\Ada Lovelace\\Goal Out')).toBe(key);
+    expect(deliveryPathKey('D:\\Users\\Ada Lovelace\\Goal Out\\hello.html')).not.toBe(key);
+  });
+
+  it('resolves relative POSIX paths against the workspace without folding case', () => {
+    expect(deliveryPathKey('hello.html', '/workspace')).toBe('/workspace/hello.html');
+    expect(deliveryPathKey('./hello.html', '/workspace/')).toBe('/workspace/hello.html');
