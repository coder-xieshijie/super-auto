+async function seedRunningGoal(tokenBudget?: number): Promise<ThreadGoalState> {
+  const created = await integration.store.create({
+    sessionId: SESSION,
+    objective: OBJECTIVE,
+    ...(tokenBudget ? { tokenBudget } : {}),
+  });
+  const enqueued = await integration.store.transitionKickoffState(
+    created.goalId,
+    created.kickoffState,
+    'enqueued',
+  );
+  const consumed = await integration.store.transitionKickoffState(
+    created.goalId,
+    enqueued?.kickoffState ?? 'enqueued',
+    'consumed',
+  );
+  if (!consumed) throw new Error('expected a kickoff-consumed Goal');
+  return consumed;
+}
+
+async function admitGoalTurn(turnId: string): Promise<void> {
+  const goal = await integration.store.getBySession(SESSION);
+  if (!goal) throw new Error('expected a Goal');
+  turnTimings.begin(SESSION, turnId);
+  const prepared = await integration.prepareTurnAdmission({
+    sessionId: SESSION,
+    turnId,
+    provenance: {
+      source: 'thread-goal',
+      sourceContext: {
+        origin: {
+          type: 'thread-goal-continuation',
+          goalId: goal.goalId,
+          goalUpdatedAt: goal.updatedAt,
+          objectiveDigest: digestThreadGoalObjective(goal.objective),
+          kind: 'active',
+        },
+      },
+    },
+    hasPendingPlan: async () => false,
+    hasPriorityMailboxWork: async () => false,
+  });
+  if (prepared?.status !== 'ready') {
+    throw new Error(`expected a ready Goal admission, got ${JSON.stringify(prepared)}`);
+  }
+  await prepared.commit();
+}
+
+/** Run one admitted Goal Turn exactly as the production hooks shape it. */
+async function runGoalTurn(turnId: string, responses: readonly ScriptedResponse[]): Promise<TurnRun> {
+  const turn = { sessionId: SESSION, turnId };
+  const gate = createGoalFinalReplyGate();
+  const abort = new AbortController();
+  const contexts: AgentMessage[][] = [];
+  const history: AgentMessage[] = [];
+  const events: IRuntimeEvent[] = [];
+  const eventWriter: PiEventWriter = {
+    pushRuntime: (event) => {
+      events.push(event);
+    },
+    appendEvents: (batch) => {
+      events.push(...batch);
+    },
+  };
+  const goalTools = await integration.runtimeToolsFor(false, SESSION);
+  let requestsAtCompletion: number | undefined;
+
+  await new PiTurnRunner().runTurn({
+    sessionId: SESSION,
+    turnId,
+    workspaceDir,
+    systemPrompt: 'Goal worker',
+    userMessage: { text: 'Continue working toward the active thread goal.' },
+    llm: { model: fakeModel(), streamFn: scriptedProvider(responses, contexts, abort) },
+    eventWriter,
+    signal: abort.signal,
+    toolConfig: { tools: [...goalTools, writeFileTool()], context: turn },
+    hooks: {
+      // Pi hands the same agent run context to both tool hooks; the gate relies on it.
+      beforeToolCallHook: [(context) => gate.refuseToolCall(context.context)],
+      afterToolCallHook: [
+        (context) => {
+          gate.observeToolResult(turn, context.context, {
+            toolName: context.toolCall.name,
+            details: context.result.details,
+            isError: context.isError,
+          });
+          if (requestsAtCompletion === undefined && gate.refuseToolCall(context.context)) {
+            requestsAtCompletion = contexts.length;
+          }
+          return undefined;
+        },
+      ],
+      afterLlmCallHook: [({ message }) => gate.reviewResponse(turn, message)],
+      onHistoryChangedHook: [
+        ({ reason, messages }) => {
+          if (reason === 'messageDelta') history.push(...messages);
+        },
+      ],
+    },
+  });
+  gate.endTurn(turn);
+
+  let status: TurnRun['status'] = 'unknown';
+  for (const event of events) {
+    if (event.type !== RuntimeEventType.SESSION_STATUS) continue;
+    if (event.payload?.status === RuntimeEventStatus.COMPLETED) status = 'completed';
+    else if (event.payload?.status === RuntimeEventStatus.ABORTED) status = 'aborted';
+    else if (event.payload?.status === RuntimeEventStatus.FAILED) status = 'failed';
+  }
+  const lastAssistant = [...history].reverse().find((message) => message.role === 'assistant');
+  const finalAssistantText =
+    lastAssistant?.role === 'assistant'
+      ? lastAssistant.content
+          .filter((block) => block.type === 'text')
+          .map((block) => block.text)
+          .join('')
+      : '';
+  return {
+    status,
+    history,
+    contexts,
+    requestsAfterCompletion:
+      requestsAtCompletion === undefined ? 0 : contexts.length - requestsAtCompletion,
+    finalAssistantText,
+  };
+}
+
+async function settle(
+  turnId: string,
+  run: TurnRun,
+  extra: { tokens?: number; failureClass?: ThreadGoalFailureClass } = {},
+) {
+  now += 1_000;
+  const decision = await integration.settleInjectedTurn({
+    sessionId: SESSION,
+    turnId,
+    status: run.status === 'unknown' ? 'failed' : run.status,
+    tokens: extra.tokens ?? 100,
+    retracted: false,
+    finalAssistantText: run.finalAssistantText,
+    workerModelKey: 'fake-provider/fake-model',
+    ...(extra.failureClass ? { failureClass: extra.failureClass } : {}),
+  });
+  turnTimings.finish(SESSION, turnId);
+  return decision;
+}
+
+function toolResults(run: TurnRun) {
+  return run.history.flatMap((message) =>
+    message.role === 'toolResult'
+      ? [
+          {
+            toolName: message.toolName,
+            isError: message.isError,
+            text: message.content
+              .filter((block) => block.type === 'text')
+              .map((block) => block.text)
+              .join(''),
+            details: message.details as Record<string, unknown> | undefined,
+          },
+        ]
+      : [],
+  );
+}
+
+/** Index in history of the accepted completion result, and what came after it. */
+function afterCompletion(run: TurnRun): AgentMessage[] {
+  const index = run.history.findIndex(
+    (message) =>
+      message.role === 'toolResult' &&
+      message.toolName === 'update_goal' &&
+      !message.isError &&
+      (message.details as { proposal?: { status?: string } } | undefined)?.proposal?.status ===
+        'complete',
+  );
+  expect(index).toBeGreaterThanOrEqual(0);
+  return run.history.slice(index + 1);
+}
