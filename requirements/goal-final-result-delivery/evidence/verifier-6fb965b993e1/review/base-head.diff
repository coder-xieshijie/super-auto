+      totalTokens: 2,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason,
+    ...(errorMessage ? { errorMessage } : {}),
+    timestamp: now,
+  };
+}
+
+/** Provider that plays `responses` in order and fails loudly on an extra request. */
+function scriptedProvider(
+  responses: readonly ScriptedResponse[],
+  contexts: AgentMessage[][],
+  abort: AbortController,
+): StreamFn {
+  let invocation = 0;
+  return (async (_model, context) => {
+    contexts.push([...(context.messages as AgentMessage[])]);
+    const response = responses[invocation];
+    invocation += 1;
+    if (!response) throw new Error(`unexpected provider request ${invocation}`);
+    if (response.type === 'abort') {
+      await response.before?.();
+      abort.abort();
+      const final = assistantMessage([], 'aborted', 'Request was aborted');
+      return eventStream([{ type: 'error', reason: 'aborted', error: final }], final);
+    }
+    if (response.type === 'error') {
+      const final = assistantMessage([], 'error', response.message);
+      return eventStream([{ type: 'error', reason: 'error', error: final }], final);
+    }
+    if (response.type === 'tool' || response.type === 'tools') {
+      if (response.type === 'tool') await response.before?.();
+      const calls = response.type === 'tool' ? [response] : response.calls;
+      const toolCalls = calls.map((call, index) => ({
+        type: 'toolCall' as const,
+        id: `call_${invocation}_${index}`,
+        name: call.name,
+        arguments: call.arguments,
+      }));
+      const final = assistantMessage(toolCalls, 'toolUse');
+      return eventStream(
+        [
+          { type: 'start', partial: final },
+          ...toolCalls.flatMap((toolCall, contentIndex): AssistantMessageEvent[] => [
+            { type: 'toolcall_start', contentIndex, partial: final },
+            { type: 'toolcall_end', contentIndex, toolCall, partial: final },
+          ]),
+          { type: 'done', reason: 'toolUse', message: final },
+        ],
+        final,
+      );
+    }
+    const text = response.type === 'text' ? response.text : '';
+    const final = assistantMessage(
+      response.type === 'text'
+        ? [{ type: 'text', text }]
+        : [{ type: 'thinking', thinking: 'nothing to add' }],
+      'stop',
+    );
+    return eventStream([{ type: 'start', partial: final }, { type: 'done', reason: 'stop', message: final }], final);
+  }) as StreamFn;
+}
+
+/** A side-effecting tool whose executions the tests count. */
+function writeFileTool(): RuntimeTool {
+  return {
+    def: {
+      name: 'write_file',
+      description: 'Write a file into the workspace.',
+      schema: {
+        type: 'object',
+        properties: { path: { type: 'string' }, content: { type: 'string' } },
+        required: ['path', 'content'],
+      } as unknown as TSchema,
+    },
+    impl: {
+      async execute(_ctx, input: { path: string; content: string }) {
+        writeExecutions.push(input.path);
+        await writeFile(join(workspaceDir, input.path), input.content);
+        const text = `wrote ${input.path}`;
+        return { tool_name: 'write_file', text, content: [{ type: 'text', text }], details: {} };
+      },
+    },
+  };
+}
+
+function toolCall(name: string, args: Record<string, unknown>): ScriptedResponse {
+  return { type: 'tool', name, arguments: args };
+}
