+import { createContext, useContext } from 'react';
+
+/**
+ * Delivery cards a completed Goal message already shows in its result area.
+ * Card renderers inside that message's process area skip these paths, so a
+ * lifted card is never shown twice when the user expands the process.
+ */
+export interface ShownDeliveryCards {
+  has(path: string): boolean;
+}
+
+const ShownDeliveryCardsContext = createContext<ShownDeliveryCards | null>(null);
+
+export const ShownDeliveryCardsProvider = ShownDeliveryCardsContext.Provider;
+
+export function useShownDeliveryCards(): ShownDeliveryCards | null {
+  return useContext(ShownDeliveryCardsContext);
+}
