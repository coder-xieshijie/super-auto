diff --git a/packages/ui/src/components/MessageContainer/MessageItem/models/goalDeliveryCards.ts b/packages/ui/src/components/MessageContainer/MessageItem/models/goalDeliveryCards.ts
new file mode 100644
index 0000000000..dd936c4d28
--- /dev/null
+++ b/packages/ui/src/components/MessageContainer/MessageItem/models/goalDeliveryCards.ts
@@ -0,0 +1,91 @@
+import type { DeliverAssetItem } from '@mavis/shared/asset-markup';
+import { normalizeAssetPathKey } from '@mavis/shared/asset-markup';
+
+import { parseDeliverAssetsContent } from '@/components/message/DeliverAssetsCard.js';
+import { joinWorkspacePath } from '@/components/previewer/preview-path.js';
+import type { MessagePart } from '@/store/message.js';
+
+/**
+ * Card lifting for a completed Goal message.
+ *
+ * The Goal result area shows the final reply; deliverables announced earlier
+ * (in reports that are now folded into the process area) must stay openable
+ * from the result area. Only the delivery cards move: the process text keeps
+ * its markup, and the process area hides the cards already shown above so a
+ * file never gets two cards in one message.
+ */
+export interface LiftedDeliveryCards {
+  /** Non-image deliverables to render as one delivery card, in first-seen order. */
+  readonly deliverItems: readonly DeliverAssetItem[];
+  /** Image deliverables to render as one gallery, in first-seen order. */
+  readonly galleryItems: readonly DeliverAssetItem[];
+  /** Every path key shown in the result area (lifted or already in the body). */
+  readonly resultPathKeys: ReadonlySet<string>;
+}
+
+const WINDOWS_ABSOLUTE = /^(?:[a-zA-Z]:[\\/]|\\\\|\/\/)/u;
+
+/**
+ * Dedupe key for a delivered path: relative paths resolve against the message
+ * workspace, separators and trailing slashes are unified, and Windows paths
+ * compare case-insensitively like the file system does.
+ */
+export function deliveryPathKey(path: string, workspaceDir?: string | null): string {
+  const trimmed = path.trim();
+  if (/^[a-z][a-z0-9+.-]*:\/\//iu.test(trimmed) || /^(?:data|blob):/iu.test(trimmed)) {
+    return trimmed;
+  }
+  const absolute = workspaceDir ? joinWorkspacePath(workspaceDir, trimmed) : trimmed;
+  const key = normalizeAssetPathKey(absolute).replace(/\/(?:\.\/)+/gu, '/');
+  return WINDOWS_ABSOLUTE.test(absolute) ? key.toLowerCase() : key;
+}
+
+interface DeliveryCardItems {
+  readonly deliver: DeliverAssetItem[];
+  readonly gallery: DeliverAssetItem[];
+}
+
+function deliveryItemsOf(content: string): DeliveryCardItems {
+  const deliver: DeliverAssetItem[] = [];
+  const gallery: DeliverAssetItem[] = [];
+  for (const segment of parseDeliverAssetsContent(content)) {
+    if (segment.type === 'deliver-assets') deliver.push(...segment.items);
+    else if (segment.type === 'image-gallery') gallery.push(...segment.items);
+  }
+  return { deliver, gallery };
+}
+
+/**
+ * Collect the delivery cards to show in the result area of a completed Goal
+ * message: every card in the process-area text, deduped by path, minus those
+ * the body (final reply) already renders. Returns `undefined` when there is
+ * nothing to lift and the body shows no cards, so nothing changes on screen.
+ */
+export function collectLiftedDeliveryCards(input: {
+  readonly processParts: readonly MessagePart[];
+  readonly bodyContent: string;
+  readonly workspaceDir?: string | null;
+}): LiftedDeliveryCards | undefined {
+  const keyOf = (item: DeliverAssetItem) => deliveryPathKey(item.path, input.workspaceDir);
+  const body = deliveryItemsOf(input.bodyContent);
+  const resultPathKeys = new Set([...body.deliver, ...body.gallery].map(keyOf));
+  const deliverItems: DeliverAssetItem[] = [];
+  const galleryItems: DeliverAssetItem[] = [];
+
+  for (const part of input.processParts) {
+    if (part.type !== 'text') continue;
+    const items = deliveryItemsOf(part.content);
+    for (const [item, target] of [
+      ...items.deliver.map((entry) => [entry, deliverItems] as const),
+      ...items.gallery.map((entry) => [entry, galleryItems] as const),
+    ]) {
+      const key = keyOf(item);
+      if (resultPathKeys.has(key)) continue;
+      resultPathKeys.add(key);
+      target.push(item);
+    }
+  }
+
+  if (resultPathKeys.size === 0) return undefined;
+  return { deliverItems, galleryItems, resultPathKeys };
+}
